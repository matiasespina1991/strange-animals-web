rules_version='2'

// ===============================================================
// Assumed Data Model (identity font browser preferences)
// ===============================================================
// Collection: users
// Document ID: random UUID stored in a SameSite cookie scoped to /identity
// Fields:
//   - version: int (required, exactly 1)
//   - favoriteFontKeys: string (required, comma-separated font IDs, <= 110 KB)
//   - pinnedFontKeys: string (required, ordered comma-separated font IDs, <= 110 KB)
//   - showOnlyFavorites: bool (required)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
// This document contains no email, name, or other PII.
//
// Collection: sharedModels
// Document ID: UUID; exact fields schemaVersion, visibility, ownerUid, title,
//   fileName, storagePath, contentType, sizeBytes, createdAt. Shares are public
//   by ID only; clients may create their own, get public documents, and cannot
//   list, update, or delete shares.
//
// Collection: designUsers/{uid}/projects/{projectId}
//   Owner-only project metadata, the latest monotonically increasing version,
//   and Cookie/Cookie+Sleeve A/B screenshot paths for the latest version.
// Subcollection: designUsers/{uid}/projects/{projectId}/versions/{versionId}
//   Immutable numbered design JSON, Cookie/Cookie+Sleeve A/B screenshots, and private GLB
//   paths in Cloud Storage. Large files are not stored in Firestore documents.
//
// Collection: fonts
// Document ID: normalized font-family ID
// Client-editable metadata fields:
//   - enabled: bool (required; controls production catalog visibility)
//   - parentCategory: string (optional, <= 64 characters)
//   - useCases: list<string> (optional, <= 3 enum values)
//   - useCase: string (legacy optional field; may only remain unchanged or be deleted)
//   - updatedAt: timestamp (required on metadata updates, server time)
// All remaining catalog fields are immutable to the client. Catalog creation
// is performed with administrative credentials; client creation is denied.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // The identity catalog is readable only by the fixed Firebase Auth account.
    // Catalog synchronization uses Admin access. The fixed identity may only
    // assign bounded visibility, category, and use-case metadata used by the catalog UI.
    function hasIdentityAccess() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email == 'identity-access@strangeanimals.de';
    }

    function isIdentityBrowserId(browserId) {
      return browserId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function isValidFontKeyString(value) {
      return value is string
        && value.size() <= 110000
        && (value == ''
          || value.matches('^[A-Za-z0-9_-]{1,200}(,[A-Za-z0-9_-]{1,200})*$'));
    }

    function isValidIdentityUserPreferences(data) {
      return data.keys().hasAll([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.version is int
        && data.version == 1
        && isValidFontKeyString(data.favoriteFontKeys)
        && isValidFontKeyString(data.pinnedFontKeys)
        && data.showOnlyFavorites is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[A-Fa-f0-9]{6}$');
    }

    function isValidBackgroundImagePath(value, browserId, setId) {
      return value is string
        && value.matches('^media/private/identity-font-sets/' + browserId + '/' + setId + '/v[0-9]+/[A-Za-z0-9_.-]{1,180}$');
    }

    function isValidIdentityFontSet(data, browserId, setId) {
      return data.keys().hasAll([
          'version',
          'label',
          'specimen',
          'search',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'fontColor',
          'backgroundColor',
          'backgroundMode',
          'fontSize',
          'fontWeight',
          'lineHeight',
          'letterSpacing',
          'textAlignment',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'label',
          'specimen',
          'search',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'fontColor',
          'backgroundColor',
          'backgroundMode',
          'backgroundImageName',
          'backgroundImageStoragePath',
          'fontSize',
          'fontWeight',
          'lineHeight',
          'letterSpacing',
          'textAlignment',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.version is int
        && data.version == 1
        && data.label is string
        && data.label.size() > 0
        && data.label.size() <= 120
        && data.specimen is string
        && data.specimen.size() <= 800
        && data.search is string
        && data.search.size() <= 140
        && isValidFontKeyString(data.favoriteFontKeys)
        && isValidFontKeyString(data.pinnedFontKeys)
        && isHexColor(data.fontColor)
        && isHexColor(data.backgroundColor)
        && data.backgroundMode in ['color', 'image']
        && (!('backgroundImageName' in data)
          || (data.backgroundImageName is string
            && data.backgroundImageName.size() > 0
            && data.backgroundImageName.size() <= 180))
        && (!('backgroundImageStoragePath' in data)
          || isValidBackgroundImagePath(
            data.backgroundImageStoragePath,
            browserId,
            setId,
          ))
        && ((data.backgroundMode == 'image'
            && ('backgroundImageName' in data)
            && ('backgroundImageStoragePath' in data))
          || (data.backgroundMode == 'color'
            && !('backgroundImageName' in data)
            && !('backgroundImageStoragePath' in data)))
        && data.fontSize is number
        && data.fontSize >= 8
        && data.fontSize <= 140
        && data.fontWeight in ['300', 'normal', '800']
        && data.lineHeight is number
        && data.lineHeight >= 0.8
        && data.lineHeight <= 2.5
        && data.letterSpacing is number
        && data.letterSpacing >= -0.1
        && data.letterSpacing <= 0.5
        && data.textAlignment in ['left', 'center', 'right']
        && data.showOnlyFavorites is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFontCatalogMetadataUpdate(data) {
      return data.diff(resource.data).affectedKeys()
          .hasOnly(['enabled', 'parentCategory', 'useCase', 'useCases', 'updatedAt', 'name', 'displayName', 'sortName'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName == data.name))
        && data.sortName is string && data.sortName.size() > 0 && data.sortName.size() <= 200
        && data.enabled is bool
        && (!('parentCategory' in data)
          || (data.parentCategory is string
            && data.parentCategory.size() <= 64))
        && (!('useCases' in data)
          || (data.useCases is list
            && data.useCases.size() <= 3
            && data.useCases.hasOnly([
              'CD Print',
              'Clothing',
              'Vinyl print'
            ])))
        && (!('useCase' in data)
          || (('useCase' in resource.data)
            && data.useCase == resource.data.useCase))
        && data.updatedAt == request.time;
    }

    function isValidFontFilePreviewUpdate(data) {
      return data.diff(resource.data).affectedKeys()
          .hasOnly(['previewEnabled', 'updatedAt'])
        && data.previewEnabled is bool
        && data.updatedAt == request.time;
    }

    match /users/{browserId} {
      // Listing is intentionally denied. The random cookie ID acts as the
      // document capability for users sharing the fixed identity Auth account.
      allow get: if hasIdentityAccess() && isIdentityBrowserId(browserId);
      allow create: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isValidIdentityUserPreferences(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isValidIdentityUserPreferences(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'updatedAt'
        ]);
      allow list, delete: if false;

      match /fontSets/{setId} {
        allow get, list: if hasIdentityAccess() && isIdentityBrowserId(browserId);
        allow create: if hasIdentityAccess()
          && isIdentityBrowserId(browserId)
          && isIdentityBrowserId(setId)
          && isValidIdentityFontSet(request.resource.data, browserId, setId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if hasIdentityAccess()
          && isIdentityBrowserId(browserId)
          && isIdentityBrowserId(setId)
          && isValidIdentityFontSet(request.resource.data, browserId, setId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow write: if false;
    }

    match /webampSkins/{skinId} {
      allow read: if true;
      allow create, update: if request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('media/public/webamp-skins/.*')
        && request.resource.data.enabled == true;
      allow delete: if false;
    }

    match /siteContent/{sectionId} {
      allow read: if true;
      allow write: if false;
    }

    // Assumed model: fonts/{fontId} contains the bounded family summary used
    // by the catalog. fonts/{fontId}/files/{fileId} contains one file manifest
    // entry. Both are private; only the fixed identity may delete them through
    // the temporary catalog-management control.
    match /fonts/{fontId} {
      allow read: if request.auth != null;
      allow delete: if hasIdentityAccess();
      allow update: if hasIdentityAccess()
        && isValidFontCatalogMetadataUpdate(request.resource.data);
      allow create: if hasIdentityAccess()
        && request.resource.data.id == fontId
        && request.resource.data.sourceFontId is string
        && exists(/databases/$(database)/documents/fonts/$(request.resource.data.sourceFontId))
        && request.resource.data.diff(get(/databases/$(database)/documents/fonts/$(request.resource.data.sourceFontId)).data).affectedKeys()
          .hasOnly(['id', 'sourceFontId', 'name', 'displayName', 'sortName', 'storagePrefix', 'preview', 'updatedAt', 'enabled', 'fileCount', 'variantCount'])
        && request.resource.data.storagePrefix == 'media/private/fonts/copies/' + fontId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.displayName == request.resource.data.name
        && request.resource.data.sortName is string
        && request.resource.data.enabled is bool
        && request.resource.data.variantCount is int
        && request.resource.data.variantCount >= 0 && request.resource.data.variantCount < 450
        && request.resource.data.fileCount is int
        && request.resource.data.fileCount > 0 && request.resource.data.fileCount < 450
        && (!('preview' in request.resource.data) || request.resource.data.preview == null
          || (request.resource.data.preview.storagePath is string
            && request.resource.data.preview.storagePath.matches('^media/private/fonts/copies/' + fontId + '/[^/]+/[^/]+$')))
        && request.resource.data.updatedAt == request.time;

      match /files/{fileId} {
        allow read: if request.auth != null;
        allow delete: if hasIdentityAccess();
        allow create: if hasIdentityAccess()
          && getAfter(/databases/$(database)/documents/fonts/$(fontId)).data.storagePrefix == 'media/private/fonts/copies/' + fontId
          && request.resource.data.id == fileId
          && request.resource.data.fontId == fontId
          && request.resource.data.diff(get(/databases/$(database)/documents/fonts/$(getAfter(/databases/$(database)/documents/fonts/$(fontId)).data.sourceFontId)/files/$(fileId)).data).affectedKeys()
            .hasOnly(['id', 'fontId', 'storagePath', 'updatedAt', 'sizeBytes'])
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('^media/private/fonts/copies/' + fontId + '/' + fileId + '/[^/]+$')
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0 && request.resource.data.sizeBytes <= 100 * 1024 * 1024
          && request.resource.data.updatedAt == request.time;
        allow update: if hasIdentityAccess()
          && isValidFontFilePreviewUpdate(request.resource.data);
      }
    }

    function isSharedModelId(modelId) {
      return modelId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function isValidSharedModel(data, modelId) {
      return data.keys().hasAll([
          'schemaVersion',
          'visibility',
          'ownerUid',
          'title',
          'fileName',
          'storagePath',
          'contentType',
          'sizeBytes',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'visibility',
          'ownerUid',
          'title',
          'fileName',
          'storagePath',
          'contentType',
          'sizeBytes',
          'createdAt'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.visibility == 'public'
        && data.ownerUid == request.auth.uid
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.fileName is string
        && data.fileName.matches('^[A-Za-z0-9_.-]{1,150}[.]glb$')
        && data.storagePath is string
        && data.storagePath == 'media/public/shared-models/'
          + request.auth.uid + '/' + modelId + '/' + data.fileName
        && data.contentType == 'model/gltf-binary'
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes <= 104857600
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    match /sharedModels/{modelId} {
      allow get: if isSharedModelId(modelId)
        && resource.data.visibility == 'public';
      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && isSharedModelId(modelId)
        && isValidSharedModel(request.resource.data, modelId);
      allow update, delete: if false;
    }

    function isDesignGalleryOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidDesignGalleryProject(data, uid, projectId) {
      return data.keys().hasAll([
          'title',
          'latestVersion',
          'latestVersionId',
          'frontPreviewPath',
          'backPreviewPath',
          'frontSleevePreviewPath',
          'backSleevePreviewPath',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'latestVersion',
          'latestVersionId',
          'frontPreviewPath',
          'backPreviewPath',
          'frontSleevePreviewPath',
          'backSleevePreviewPath',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.latestVersion is int
        && data.latestVersion >= 1
        && data.latestVersion <= 999999
        && data.latestVersionId is string
        && isSharedModelId(data.latestVersionId)
        && data.frontPreviewPath == 'media/private/design-gallery/'
          + uid + '/' + projectId + '/' + data.latestVersionId + '/front.png'
        && data.backPreviewPath == 'media/private/design-gallery/'
          + uid + '/' + projectId + '/' + data.latestVersionId + '/back.png'
        && (!('frontSleevePreviewPath' in data)
          || data.frontSleevePreviewPath == 'media/private/design-gallery/'
            + uid + '/' + projectId + '/' + data.latestVersionId + '/front-with-sleeve.png')
        && (!('backSleevePreviewPath' in data)
          || data.backSleevePreviewPath == 'media/private/design-gallery/'
            + uid + '/' + projectId + '/' + data.latestVersionId + '/back-with-sleeve.png')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidDesignGalleryVersion(data, uid, projectId, versionId) {
      return isSharedModelId(versionId)
        && data.keys().hasAll([
          'version',
          'designPath',
          'frontPreviewPath',
          'backPreviewPath',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'version',
          'designPath',
          'frontPreviewPath',
          'backPreviewPath',
          'frontSleevePreviewPath',
          'backSleevePreviewPath',
          'modelPath',
          'modelFileName',
          'modelSizeBytes',
          'createdAt'
        ])
        && data.version is int
        && data.version >= 1
        && data.version <= 999999
        && data.designPath == 'media/private/design-gallery/'
          + uid + '/' + projectId + '/' + versionId + '/design.json'
        && data.frontPreviewPath == 'media/private/design-gallery/'
          + uid + '/' + projectId + '/' + versionId + '/front.png'
        && data.backPreviewPath == 'media/private/design-gallery/'
          + uid + '/' + projectId + '/' + versionId + '/back.png'
        && (!('frontSleevePreviewPath' in data)
          || data.frontSleevePreviewPath == 'media/private/design-gallery/'
            + uid + '/' + projectId + '/' + versionId + '/front-with-sleeve.png')
        && (!('backSleevePreviewPath' in data)
          || data.backSleevePreviewPath == 'media/private/design-gallery/'
            + uid + '/' + projectId + '/' + versionId + '/back-with-sleeve.png')
        && ((!('modelPath' in data)
            && !('modelFileName' in data)
            && !('modelSizeBytes' in data))
          || (data.modelPath == 'media/private/design-gallery/'
              + uid + '/' + projectId + '/' + versionId + '/model.glb'
            && data.modelFileName is string
            && data.modelFileName.matches('^[A-Za-z0-9_.-]{1,150}[.]glb$')
            && data.modelSizeBytes is int
            && data.modelSizeBytes > 0
            && data.modelSizeBytes <= 104857600))
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/designUsers/$(uid)/projects/$(projectId)).data.latestVersion == data.version
        && getAfter(/databases/$(database)/documents/designUsers/$(uid)/projects/$(projectId)).data.latestVersionId == versionId;
    }

    match /designUsers/{uid}/projects/{projectId} {
      allow get, list: if isDesignGalleryOwner(uid);
      allow create: if isDesignGalleryOwner(uid)
        && isValidDesignGalleryProject(request.resource.data, uid, projectId)
        && request.resource.data.latestVersion == 1
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/designUsers/$(uid)/projects/$(projectId)/versions/$(request.resource.data.latestVersionId));
      allow update: if isDesignGalleryOwner(uid)
        && isValidDesignGalleryProject(request.resource.data, uid, projectId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.latestVersion == resource.data.latestVersion + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'latestVersion',
          'latestVersionId',
          'frontPreviewPath',
          'backPreviewPath',
          'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/designUsers/$(uid)/projects/$(projectId)/versions/$(request.resource.data.latestVersionId));
      allow delete: if false;

      match /versions/{versionId} {
        allow get, list: if isDesignGalleryOwner(uid);
        allow create: if isDesignGalleryOwner(uid)
          && isValidDesignGalleryVersion(request.resource.data, uid, projectId, versionId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
