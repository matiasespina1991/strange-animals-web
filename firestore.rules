rules_version='2'

// ===============================================================
// Assumed Data Model (identity font browser preferences)
// ===============================================================
// Collection: users
// Document ID: random UUID stored in a SameSite cookie scoped to /identity
// Fields:
//   - version: int (required, exactly 1)
//   - favoriteFontKeys: string (required, comma-separated font IDs, <= 110 KB)
//   - pinnedFontKeys: string (required, ordered comma-separated font IDs, <= 110 KB)
//   - showOnlyFavorites: bool (required)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
// This document contains no email, name, or other PII.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // The identity catalog is readable only by the fixed Firebase Auth account.
    // Catalog synchronization uses Admin access. The fixed identity may only
    // assign the bounded parent-category metadata used by the catalog UI.
    function hasIdentityAccess() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email == 'identity-access@strangeanimals.de';
    }

    function isIdentityBrowserId(browserId) {
      return browserId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function isValidFontKeyString(value) {
      return value is string
        && value.size() <= 110000
        && (value == ''
          || value.matches('^[A-Za-z0-9_-]{1,200}(,[A-Za-z0-9_-]{1,200})*$'));
    }

    function isValidIdentityUserPreferences(data) {
      return data.keys().hasAll([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.version is int
        && data.version == 1
        && isValidFontKeyString(data.favoriteFontKeys)
        && isValidFontKeyString(data.pinnedFontKeys)
        && data.showOnlyFavorites is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[A-Fa-f0-9]{6}$');
    }

    function isValidBackgroundImagePath(value, browserId, setId) {
      return value is string
        && value.matches('^media/private/identity-font-sets/' + browserId + '/' + setId + '/v[0-9]+/[A-Za-z0-9_.-]{1,180}$');
    }

    function isValidIdentityFontSet(data, browserId, setId) {
      return data.keys().hasAll([
          'version',
          'label',
          'specimen',
          'search',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'fontColor',
          'backgroundColor',
          'backgroundMode',
          'fontSize',
          'fontWeight',
          'lineHeight',
          'letterSpacing',
          'textAlignment',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'label',
          'specimen',
          'search',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'fontColor',
          'backgroundColor',
          'backgroundMode',
          'backgroundImageName',
          'backgroundImageStoragePath',
          'fontSize',
          'fontWeight',
          'lineHeight',
          'letterSpacing',
          'textAlignment',
          'showOnlyFavorites',
          'createdAt',
          'updatedAt'
        ])
        && data.version is int
        && data.version == 1
        && data.label is string
        && data.label.size() > 0
        && data.label.size() <= 120
        && data.specimen is string
        && data.specimen.size() <= 800
        && data.search is string
        && data.search.size() <= 140
        && isValidFontKeyString(data.favoriteFontKeys)
        && isValidFontKeyString(data.pinnedFontKeys)
        && isHexColor(data.fontColor)
        && isHexColor(data.backgroundColor)
        && data.backgroundMode in ['color', 'image']
        && (!('backgroundImageName' in data)
          || (data.backgroundImageName is string
            && data.backgroundImageName.size() > 0
            && data.backgroundImageName.size() <= 180))
        && (!('backgroundImageStoragePath' in data)
          || isValidBackgroundImagePath(
            data.backgroundImageStoragePath,
            browserId,
            setId,
          ))
        && ((data.backgroundMode == 'image'
            && ('backgroundImageName' in data)
            && ('backgroundImageStoragePath' in data))
          || (data.backgroundMode == 'color'
            && !('backgroundImageName' in data)
            && !('backgroundImageStoragePath' in data)))
        && data.fontSize is number
        && data.fontSize >= 8
        && data.fontSize <= 140
        && data.fontWeight in ['300', 'normal', '800']
        && data.lineHeight is number
        && data.lineHeight >= 0.8
        && data.lineHeight <= 2.5
        && data.letterSpacing is number
        && data.letterSpacing >= -0.1
        && data.letterSpacing <= 0.5
        && data.textAlignment in ['left', 'center', 'right']
        && data.showOnlyFavorites is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{browserId} {
      // Listing is intentionally denied. The random cookie ID acts as the
      // document capability for users sharing the fixed identity Auth account.
      allow get: if hasIdentityAccess() && isIdentityBrowserId(browserId);
      allow create: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isValidIdentityUserPreferences(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isValidIdentityUserPreferences(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version',
          'favoriteFontKeys',
          'pinnedFontKeys',
          'showOnlyFavorites',
          'updatedAt'
        ]);
      allow list, delete: if false;

      match /fontSets/{setId} {
        allow get, list: if hasIdentityAccess() && isIdentityBrowserId(browserId);
        allow create: if hasIdentityAccess()
          && isIdentityBrowserId(browserId)
          && isIdentityBrowserId(setId)
          && isValidIdentityFontSet(request.resource.data, browserId, setId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if hasIdentityAccess()
          && isIdentityBrowserId(browserId)
          && isIdentityBrowserId(setId)
          && isValidIdentityFontSet(request.resource.data, browserId, setId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow write: if false;
    }

    match /webampSkins/{skinId} {
      allow read: if true;
      allow create, update: if request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('media/public/webamp-skins/.*')
        && request.resource.data.enabled == true;
      allow delete: if false;
    }

    match /siteContent/{sectionId} {
      allow read: if true;
      allow write: if false;
    }

    // Assumed model: fonts/{fontId} contains the bounded family summary used
    // by the catalog. fonts/{fontId}/files/{fileId} contains one file manifest
    // entry. Both are private; only the fixed identity may delete them through
    // the temporary catalog-management control.
    match /fonts/{fontId} {
      allow read: if hasIdentityAccess();
      allow delete: if hasIdentityAccess();
      allow update: if hasIdentityAccess()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['parentCategory', 'updatedAt'])
        && (!('parentCategory' in request.resource.data)
          || (request.resource.data.parentCategory is string
            && request.resource.data.parentCategory.size() <= 64))
        && request.resource.data.updatedAt == request.time;
      allow create: if false;

      match /files/{fileId} {
        allow read: if hasIdentityAccess();
        allow delete: if hasIdentityAccess();
        allow create, update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
