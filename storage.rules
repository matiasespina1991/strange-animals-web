rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasIdentityAccess() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email == 'identity-access@strangeanimals.de';
    }

    function isIdentityBrowserId(value) {
      return value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    match /media/public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /media/public/webamp-skins/{skinId}/{version}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /media/private/fonts/{allPaths=**} {
      allow read: if request.auth != null;
      allow delete: if hasIdentityAccess();
      allow create, update: if false;
    }

    match /media/private/fonts/copies/{fontId}/{fileId}/{fileName} {
      allow create: if hasIdentityAccess()
        && fontId.matches('^[A-Za-z0-9_-]{1,200}$')
        && fileId.matches('^[A-Za-z0-9_-]{1,200}$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024;
    }

    match /media/private/identity-font-sets/{browserId}/{setId}/{version}/{fileName} {
      allow read: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isIdentityBrowserId(setId)
        && version.matches('^v[0-9]+$');
      allow write: if hasIdentityAccess()
        && isIdentityBrowserId(browserId)
        && isIdentityBrowserId(setId)
        && version.matches('^v[0-9]+$')
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    match /media/public/shared-models/{ownerUid}/{modelId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && modelId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,150}[.]glb$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 104857600
        && request.resource.contentType == 'model/gltf-binary';
      allow delete: if request.auth != null
        && request.auth.uid == ownerUid
        && modelId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,150}[.]glb$');
    }

    match /media/private/design-gallery/{uid}/{projectId}/{versionId}/{fileName} {
      function ownsGalleryAsset() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validGalleryAssetPath() {
        return projectId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && versionId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && fileName in ['design.json', 'front.png', 'back.png', 'front-with-sleeve.png', 'back-with-sleeve.png', 'model.glb'];
      }

      allow read: if ownsGalleryAsset() && validGalleryAssetPath();
      allow create: if ownsGalleryAsset()
        && validGalleryAssetPath()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 104857600
        && ((fileName == 'design.json'
            && request.resource.contentType == 'application/json')
          || (fileName in ['front.png', 'back.png', 'front-with-sleeve.png', 'back-with-sleeve.png']
            && request.resource.contentType == 'image/png')
          || (fileName == 'model.glb'
            && request.resource.contentType == 'model/gltf-binary'));
      allow update: if false;
      allow delete: if ownsGalleryAsset() && validGalleryAssetPath();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
