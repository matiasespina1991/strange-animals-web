{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/listen/sajs001",
        "destination": "/route-meta/listen-sajs001.html"
      },
      {
        "source": "/listen/sajs001/**",
        "destination": "/route-meta/listen-sajs001.html"
      },
      {
        "source": "/listen/sajs001cd",
        "destination": "/route-meta/listen-sajs001cd.html"
      },
      {
        "source": "/listen/sajs001cd/**",
        "destination": "/route-meta/listen-sajs001cd.html"
      },
      {
        "source": "/listen/sajs003",
        "destination": "/route-meta/listen-sajs003.html"
      },
      {
        "source": "/listen/sajs003/**",
        "destination": "/route-meta/listen-sajs003.html"
      },
      {
        "source": "/identity/typography/typefaces",
        "destination": "/route-meta/identity-fonts.html"
      },
      {
        "source": "/identity/typography/typefaces/**",
        "destination": "/route-meta/identity-fonts.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/identity/fonts",
        "destination": "/identity/typography/typefaces",
        "type": 301
      },
      {
        "source": "/identity/fonts/**",
        "destination": "/identity/typography/typefaces",
        "type": 301
      },
      {
        "source": "/identity/typefaces/fonts",
        "destination": "/identity/typography/typefaces",
        "type": 301
      },
      {
        "source": "/identity/typefaces/fonts/**",
        "destination": "/identity/typography/typefaces",
        "type": 301
      },
      {
        "source": "/fonts",
        "destination": "/identity/typography/typefaces",
        "type": 301
      },
      {
        "source": "/fonts/**",
        "destination": "/identity/typography/typefaces",
        "type": 301
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
